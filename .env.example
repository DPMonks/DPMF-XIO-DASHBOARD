# Public indexer. These names are safe to commit. Never put Xaman secrets here.
# The browser uses a same-origin /api proxy by default so Railway Hikari 429s
# do not block the dashboard. Cluster v1 identity headers are added by the
# proxy. Set VITE_USE_DIRECT_INDEXER=true only to skip it.
VITE_API_BASE=https://dpmf-xio-indexer-TEST.up.railway.app
NEXT_PUBLIC_INDEXER_URL=https://dpmf-xio-indexer-TEST.up.railway.app
# VITE_USE_DIRECT_INDEXER=true
# VITE_API_URL=http://localhost:3000

# Xaman — server-only for /api/xaman/* (Vite middleware + Vercel functions).
# Copy this file to .env for local use. Real values stay out of git:
#   GitHub → Settings → Secrets and variables → Actions
#   Vercel → Project → Settings → Environment Variables (Production + Preview)
# Do not prefix the API secret with VITE_ (that would bake it into the client bundle).
XUMM_API_KEY=
XUMM_API_SECRET=

# Optional read-only copy of the indexer Postgres. Server only (Vite/Vercel/`npm start`).
# Same XIO tables the indexer SELECTs. Never starts workers. No VITE_ prefix.
# This is NOT the indexer HTTP host. Wrong:
#   DATABASE_URL=https://dpmf-xio-indexer-TEST.up.railway.app
# That URL is VITE_API_BASE only. Prefer splitting the password so @/#/% cannot break the URL:
#   DATABASE_URL=postgres://postgres@acela.proxy.rlwy.net:48994/railway
#   POSTGRES_PASSWORD=the-railway-password
# Do not append ?sslmode=require — Railway's TCP proxy cert then fails.

# Hybrid / AIM smart chart display: clip absurd candle wicks/closes from thin AMM/swap prints.
# Display-only (keeps real timestamps). Pair-aware: tighter for XIO DEX, milder for XRP/RLUSD CEX. Off: VITE_CHART_WICK_CLIP=false.
# VITE_CHART_WICK_CLIP=true
# VITE_CHART_WICK_ATR_PERIOD=14
# VITE_CHART_WICK_ATR_MULT=6
# VITE_CHART_WICK_BODY_MULT=8
# VITE_CHART_WICK_MAX_FRAC=0.75
# VITE_CHART_WICK_FLOOR_FRAC=0.005
# VITE_CHART_WICK_CLOSE_CLIP=true
# VITE_CHART_WICK_CLOSE_MULT=8
# VITE_CHART_WICK_CLOSE_RATIO=4
# VITE_CHART_WICK_CLOSE_SAMPLES=3

# XRP/RLUSD chart tape: same-origin /api/chart/cex-candles proxies Bitstamp XRP/USD
# (Kraken/Coinbase fallback). Browser never calls CEX hosts directly (CSP).
